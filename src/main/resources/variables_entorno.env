# ============================================================
# Render / Java
# ============================================================
PORT=8080
JAVA_VERSION=21

# ============================================================
# Base de datos - Somee SQL Server
# ============================================================
DB_URL=jdbc:sqlserver://subastar_db.mssql.somee.com:1433;databaseName=subastar_db;encrypt=true;trustServerCertificate=true
DB_USERNAME=uadelnInform_SQLLogin_1
DB_PASSWORD=TU_PASSWORD_DE_SOMEE

# ============================================================
# JPA / Hibernate / Flyway
# ============================================================
DDL_AUTO=none
SHOW_SQL=false
FLYWAY_ENABLED=false
HIBERNATE_SQL_LOG_LEVEL=WARN
HIBERNATE_BINDER_LOG_LEVEL=WARN

# ============================================================
# JWT
# ============================================================
JWT_SECRET=TU_SECRET_LARGO_DE_AL_MENOS_32_CARACTERES_CAMBIAR_ESTO
JWT_EXPIRATION=86400000

# ============================================================
# CORS
# Por ahora dejalo local. Cuando tengas Vercel, agregás la URL de Vercel.
# Ejemplo final:
# CORS_ALLOWED_ORIGINS=http://localhost:8081,https://tu-front.vercel.app
# ============================================================
CORS_ALLOWED_ORIGINS=http://localhost:8081

# ============================================================
# Multipart
# ============================================================
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=50MB

# ============================================================
# Gmail API (HTTPS)
# ============================================================
GMAIL_CLIENT_ID=TU_CLIENT_ID_DE_GOOGLE
GMAIL_CLIENT_SECRET=TU_CLIENT_SECRET_DE_GOOGLE
GMAIL_REFRESH_TOKEN=TU_REFRESH_TOKEN_DE_GOOGLE
GMAIL_FROM=subastarapp@gmail.com

# ============================================================
# Cloudinary
# ============================================================
CLOUDINARY_CLOUD_NAME=TU_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=TU_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=TU_CLOUDINARY_API_SECRET

# ============================================================
# Scheduler
# ============================================================
VERIFICACION_MEDIOS_DELAY=10000
